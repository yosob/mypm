{
  "name": "mypm",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "chat": "tsx src/chat.ts",
    "check": "tsx src/run-check.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test-db.ts && tsx scripts/test-config.ts && tsx scripts/test-providers.ts",
    "test:session": "tsx scripts/test-session.ts",
    "test:web": "python scripts/debug-web.py"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.3",
    "@earendil-works/pi-ai": "0.84.3",
    "@hono/node-server": "^1.14.0",
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "better-sqlite3": "^13.0.3",
    "dhtmlx-gantt": "^10.0.2",
    "hono": "^4.7.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "description": "AI-native personal project manager: chat with it on Lark/Feishu, it extracts meeting notes into tasks, tracks milestones, and reminds you. Local SQLite + web Gantt dashboard.",
  "license": "MIT",
  "author": "yanshibo",
  "keywords": [
    "ai-agent",
    "project-management",
    "lark",
    "feishu",
    "gantt",
    "personal-assistant",
    "pi-agent",
    "glm",
    "sqlite"
  ],
  "engines": {
    "node": ">=22"
  }
}
