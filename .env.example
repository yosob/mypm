# Vikunja 配置
VIKUNJA_URL=http://localhost:3456/api/v1
# 在 Vikunja 网页 Settings -> API Tokens 中生成，权限给 task & project 读写
VIKUNJA_TOKEN=

# LLM 配置（OpenAI 兼容 API）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 飞书群自定义机器人 Webhook
FEISHU_WEBHOOK=

# 提醒配置：提前几天开始提醒
REMIND_DAYS=7
